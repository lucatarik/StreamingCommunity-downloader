+"""A job never has two attempts alive at once.
+
+This is the guarantee the download engine was moved into a child process to
+provide, and everything else about resume rests on it. Before, a forced resume
+launched a second attempt immediately, because a blocked one could not be
+stopped: the two then shared a job object and a temp directory, overwrote each
+other's status, and — worse — each other's files. The workarounds for that (a
+generation counter, per-generation temp folders, hardlink migration between
+them, a "am I still current?" check before every write) were deleted once the
+stop became enforceable, so these tests exist to keep that assumption honest.
+"""
+
+import threading
+import time
+
+import pytest
+
+from app.jobs import ATTEMPT_STOP_TIMEOUT, JobManager
+from app.progress import DownloadCancelledError
+
+
+@pytest.fixture
+def manager():
+    return JobManager()
+
+
+class Attempt:
+    """A fake download that blocks until told to stop, and records overlap."""
+
+    def __init__(self):
+        self.started = threading.Event()
+        self.release = threading.Event()
+        self.live = 0
+        self.max_live = 0
+        self._lock = threading.Lock()
+        self.runs = 0
+
+    def __call__(self, *args, cancel_event=None, **kwargs):
+        with self._lock:
+            self.runs += 1
+            self.live += 1
+            self.max_live = max(self.max_live, self.live)
+        self.started.set()
+        try:
+            # Stand in for the engine subprocess: stop when cancelled, as the
+            # real bridge does once it has reaped the child.
+            while not self.release.is_set():
+                if cancel_event is not None and cancel_event.is_set():
+                    raise DownloadCancelledError("Annullato")
+                time.sleep(0.01)
+            return "/library/Film (2020)/Film (2020).mkv"
+        finally:
+            with self._lock:
+                self.live -= 1
+
+
+def _submit(manager: JobManager, attempt, monkeypatch) -> "object":
+    """Start a film download whose actual work is `attempt`.
+
+    Patched at `app.core.film.download_film` rather than passed in, because a
+    resume rebuilds the call from the job's saved params — going through the
+    real seam is what makes the test meaningful.
+    """
+    monkeypatch.setattr("app.core.film.download_film", attempt)
+    job_id = manager.submit_film(1, "Film", "example.test", year="2020")
+    job = manager.get(job_id)
+    assert attempt.started.wait(timeout=5), "the first attempt never started"
+    return job
+
+
+def test_resume_waits_for_the_previous_attempt_to_stop(manager, monkeypatch):
+    """The second attempt must not begin while the first is still running."""
+    attempt = Attempt()
+    job = _submit(manager, attempt, monkeypatch)
+    job.stalled = True  # only a stalled running job may be force-resumed
+
+    assert manager.resume(job.job_id) is True
+
+    # Give the resume every chance to misbehave: if it launched immediately,
+    # both attempts would be inside the fake download at once.
+    time.sleep(0.3)
+    assert attempt.max_live == 1, "two attempts were alive at the same time"
+
+    # The first attempt observes its cancellation and exits, letting the second
+    # start; then let that one finish.
+    attempt.release.set()
+    deadline = time.time() + 5
+    while attempt.runs < 2 and time.time() < deadline:
+        time.sleep(0.01)
+    assert attempt.runs == 2, "the resumed attempt never ran"
+    assert attempt.max_live == 1
+
+
+def test_resume_gets_a_fresh_cancel_event(manager, monkeypatch):
+    """A resumed attempt must not inherit the flag that stopped the last one."""
+    attempt = Attempt()
+    job = _submit(manager, attempt, monkeypatch)
+    job.stalled = True
+    original = job.cancel_event
+
+    manager.resume(job.job_id)
+
+    assert job.cancel_event is not original
+    assert original.is_set(), "the previous attempt must have been told to stop"
+    assert not job.cancel_event.is_set()
+    attempt.release.set()
+
+
+def test_a_healthy_running_job_is_not_resumable(manager, monkeypatch):
+    """Force-restarting a download that is making progress would be destructive."""
+    attempt = Attempt()
+    job = _submit(manager, attempt, monkeypatch)
+    job.stalled = False
+
+    assert manager.resume(job.job_id) is False
+    assert attempt.runs == 1
+    attempt.release.set()
+
+
+def test_every_attempt_shares_one_temp_directory(manager):
+    """Per-generation temp folders are gone; resume relies on reusing one.
+
+    The engine writes each segment atomically, so a file visible in this
+    directory is a finished file — which is what makes sharing it safe, and
+    what makes a resume skip work instead of redoing it.
+    """
+    job = manager._make_job("Film", "film")
+    job.params = {
+        "id": 1, "title": "Film", "domain": "example.test", "year": None,
+        "audio_languages": ["ita"], "subtitle_languages": [],
+    }
+
+    _, _, first = manager._build_call("film", job.params, job)
+    _, _, second = manager._build_call("film", job.params, job)
+
+    assert first["temp_dir"] == second["temp_dir"]
+    assert "gen_" not in first["temp_dir"]
+    assert job.job_id in first["temp_dir"]
+
+
+def test_a_stuck_previous_attempt_blocks_the_resume_instead_of_racing_it(
+    manager, monkeypatch
+):
+    """If the old attempt will not die, refuse rather than run two at once.
+
+    Starting anyway is precisely the situation that corrupted files in
+    production, so the job is failed with something the user can act on.
+    """
+    monkeypatch.setattr("app.jobs.ATTEMPT_STOP_TIMEOUT", 0.2)
+    assert ATTEMPT_STOP_TIMEOUT > 0  # the real value is a sane default
+
+    stuck = Attempt()
+
+    def ignores_cancellation(*args, **kwargs):
+        # Deliberately never checks cancel_event — the pathological case.
+        stuck.started.set()
+        stuck.release.wait(timeout=10)
+        return "/library/never.mkv"
+
+    monkeypatch.setattr("app.core.film.download_film", ignores_cancellation)
+    job = manager.get(manager.submit_film(1, "Film", "example.test"))
+    assert stuck.started.wait(timeout=5)
+    job.stalled = True
+
+    assert manager.resume(job.job_id) is True
+
+    deadline = time.time() + 5
+    while job.status != "error" and time.time() < deadline:
+        time.sleep(0.01)
+
+    assert job.status == "error", "a resume that cannot proceed must say so"
+    assert "precedente" in (job.error or ""), job.error
+    stuck.release.set()
diff --git a/tests/test_sse_stream.py b/tests/test_sse_stream.py
new file mode 100644
index 0000000..483cae3
--- /dev/null
+++ b/tests/test_sse_stream.py
@@ -0,0 +1,94 @@
+"""A slow SSE consumer must lose events, never its connection.
+
+The downloads tab used to stop updating until the page was reloaded. The cause
+was here: a subscriber whose queue filled up was unsubscribed, but its SSE
+generator stayed alive, blocked on a queue nobody would ever fill again, and
+kept emitting keepalives. The browser therefore saw a healthy connection,
+EventSource never fired `onerror`, and no reconnect — and no fresh snapshot —
+ever happened. A backgrounded tab consuming slowly was enough to trigger it.
+"""
+
+import asyncio
+
+import pytest
+
+from app.jobs import JobManager
+
+
+@pytest.fixture
+def manager():
+    return JobManager()
+
+
+def _fill(q: asyncio.Queue, count: int):
+    for i in range(count):
+        q.put_nowait({"type": "progress", "seq": i})
+
+
+def test_a_saturated_consumer_keeps_its_subscription(manager):
+    q = manager.subscribe()
+    _fill(q, q.maxsize)
+    assert q.full()
+
+    asyncio.run(manager._fanout({"type": "job_created", "job_id": "abc"}))
+
+    assert manager.is_subscribed(q), (
+        "dropping the subscriber leaves its SSE stream alive but deaf, which is "
+        "invisible to the browser"
+    )
+
+
+def test_the_oldest_event_is_dropped_not_the_newest(manager):
+    """The newest event matters most; the oldest is a superseded progress tick."""
+    q = manager.subscribe()
+    _fill(q, q.maxsize)
+
+    asyncio.run(manager._fanout({"type": "job_created", "job_id": "abc"}))
+
+    drained = []
+    while not q.empty():
+        drained.append(q.get_nowait())
+
+    assert drained[-1] == {"type": "job_created", "job_id": "abc"}
+    assert drained[0]["seq"] == 1, "the oldest queued event should have gone"
+    assert len(drained) == q.maxsize
+
+
+def test_a_healthy_consumer_receives_everything(manager):
+    q = manager.subscribe()
+    events = [{"type": "job_status", "n": i} for i in range(5)]
+    for event in events:
+        asyncio.run(manager._fanout(event))
+
+    drained = [q.get_nowait() for _ in range(q.qsize())]
+    assert drained == events
+
+
+def test_unsubscribing_is_observable(manager):
+    """The SSE endpoint ends the response on this, so it has to be truthful."""
+    q = manager.subscribe()
+    assert manager.is_subscribed(q) is True
+
+    manager.unsubscribe(q)
+    assert manager.is_subscribed(q) is False
+
+    # And a fanout to nobody must not raise.
+    asyncio.run(manager._fanout({"type": "job_created"}))
+
+
+def test_fanout_reaches_every_subscriber(manager):
+    first, second = manager.subscribe(), manager.subscribe()
+    asyncio.run(manager._fanout({"type": "job_dismissed", "job_id": "x"}))
+
+    assert first.get_nowait() == {"type": "job_dismissed", "job_id": "x"}
+    assert second.get_nowait() == {"type": "job_dismissed", "job_id": "x"}
+
+
+def test_one_saturated_consumer_does_not_starve_another(manager):
+    slow, fast = manager.subscribe(), manager.subscribe()
+    _fill(slow, slow.maxsize)
+
+    asyncio.run(manager._fanout({"type": "done", "job_id": "x"}))
+
+    assert manager.is_subscribed(slow)
+    assert fast.get_nowait() == {"type": "done", "job_id": "x"}
diff --git a/tests/test_stall_detection.py b/tests/test_stall_detection.py
new file mode 100644
index 0000000..dafa405
--- /dev/null
+++ b/tests/test_stall_detection.py
@@ -0,0 +1,70 @@
+"""Stall detection must not fire on phases that are silent by design.
+
+ffmpeg muxing a two-hour film emits no progress for minutes. Flagging that as
+stalled painted a healthy job orange and offered a "Forza ripresa" button that
+would have thrown away a finished download to start it over.
+"""
+
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from app.jobs import NON_PROGRESS_PHASES, STALL_THRESHOLD, JobManager
+
+
+@pytest.fixture
+def manager():
+    return JobManager()
+
+
+def _running_job(manager: JobManager, phase, silent_for: float):
+    job = manager._make_job("Film", "film")
+    job.status = "running"
+    job.phase = phase
+    job.last_progress_at = datetime.now(timezone.utc) - timedelta(seconds=silent_for)
+    return job
+
+
+def _check(manager: JobManager, job):
+    manager._check_stalls([job], datetime.now(timezone.utc))
+    return job.stalled
+
+
+@pytest.mark.parametrize("phase", sorted(NON_PROGRESS_PHASES))
+def test_muxing_phases_are_never_flagged_as_stalled(manager, phase):
+    job = _running_job(manager, phase, silent_for=STALL_THRESHOLD * 10)
+    assert _check(manager, job) is False, f"{phase} is silent by design"
+
+
+def test_a_silent_download_phase_is_still_flagged(manager):
+    """The heuristic must keep working where it is actually meaningful."""
+    job = _running_job(manager, "video", silent_for=STALL_THRESHOLD + 10)
+    assert _check(manager, job) is True
+
+
+@pytest.mark.parametrize("phase", ["video", "audio_ita"])
+def test_a_progressing_job_is_left_alone(manager, phase):
+    job = _running_job(manager, phase, silent_for=1)
+    assert _check(manager, job) is False
+
+
+def test_only_running_jobs_are_considered(manager):
+    """A finished job that sat idle must not turn orange after the fact."""
+    job = _running_job(manager, "video", silent_for=STALL_THRESHOLD * 5)
+    job.status = "done"
+    assert _check(manager, job) is False
+
+
+def test_a_phase_transition_clears_a_stall_and_resets_the_clock(manager):
+    """Announcing a new phase is proof of life, even with nothing to count."""
+    job = _running_job(manager, "video", silent_for=STALL_THRESHOLD + 10)
+    assert _check(manager, job) is True
+
+    factory = manager._make_progress_factory(job)
+    bar = factory(total=0, phase="joining")
+    bar.emit_status("joining")
+
+    assert job.stalled is False
+    assert job.phase == "joining"
+    # And it stays clear now that it is in a silent phase.
+    assert _check(manager, job) is False
