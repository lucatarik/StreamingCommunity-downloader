@@ -0,0 +1,644 @@
+//! Muxing: concatenating segments into a playable file, and the final remux.
+//!
+//! The segments are streamed into ffmpeg's stdin instead of being concatenated
+//! into a `_combined.ts` on disk first. That halves the I/O for a multi-gigabyte
+//! film, and — more to the point — it deletes the file that caused a production
+//! crash: a half-written `_combined.ts` left in the segment directory by an
+//! interrupted attempt was picked up by the next attempt's directory listing
+//! and treated as segment number zero.
+
+use std::path::{Path, PathBuf};
+use std::process::Stdio;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::process::{Child, Command};
+use tokio_util::sync::CancellationToken;
+
+use crate::error::{EngineError, IoContext, Result};
+use crate::lang;
+
+/// Only the tail of ffmpeg's stderr is worth surfacing; it is verbose and the
+/// last lines carry the actual complaint.
+const STDERR_KEEP: usize = 1200;
+
+/// The ffmpeg binary, chosen once at startup by the caller.
+static FFMPEG_BIN: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+
+/// Record which ffmpeg to run. Ignored if called more than once.
+pub fn set_binary(path: String) {
+    let _ = FFMPEG_BIN.set(path);
+}
+
+fn binary() -> &'static str {
+    FFMPEG_BIN.get().map(String::as_str).unwrap_or("ffmpeg")
+}
+
+#[derive(Debug, Clone)]
+pub struct AudioTrack {
+    pub path: PathBuf,
+    pub language: String,
+}
+
+#[derive(Debug, Clone)]
+pub struct SubtitleTrack {
+    pub path: PathBuf,
+    pub language: String,
+}
+
+fn spawn(args: &[&str], stage: &str) -> Result<Child> {
+    Command::new(binary())
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|e| {
+            if e.kind() == std::io::ErrorKind::NotFound {
+                EngineError::FfmpegMissing
+            } else {
+                EngineError::Ffmpeg {
+                    stage: stage.to_string(),
+                    code: "spawn".into(),
+                    stderr: e.to_string(),
+                }
+            }
+        })
+}
+
+fn tail(buf: &[u8]) -> String {
+    let text = String::from_utf8_lossy(buf);
+    let trimmed = text.trim();
+    if trimmed.len() <= STDERR_KEEP {
+        return trimmed.to_string();
+    }
+    let start = trimmed.len() - STDERR_KEEP;
+    // Never split a UTF-8 sequence.
+    let start = (start..trimmed.len())
+        .find(|i| trimmed.is_char_boundary(*i))
+        .unwrap_or(trimmed.len());
+    format!("...{}", &trimmed[start..])
+}
+
+/// Whether `path` is written by the mov/mp4 muxer.
+///
+/// `movflags` is private to that muxer. Handed to Matroska, some ffmpeg builds
+/// refuse the whole command — at the end of a download, after every byte has
+/// been fetched — so it is added only where it means something.
+fn is_mp4(path: &Path) -> bool {
+    path.extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("mp4"))
+}
+
+/// Where the remux writes before replacing `output`.
+///
+/// The remux reads and writes the same extension, so it cannot write in place.
+/// A sibling rather than a file under the temp dir, because a rename cannot
+/// cross filesystems; dot-prefixed, so a Jellyfin scan running meanwhile does
+/// not index the half-written file as a second copy. The extension is kept:
+/// it is what tells ffmpeg which muxer to use.
+pub fn staging_path(output: &Path) -> PathBuf {
+    let name = output
+        .file_name()
+        .map(|n| n.to_string_lossy().into_owned())
+        .unwrap_or_default();
+    output.with_file_name(format!(".{name}"))
+}
+
+/// What the joined output is actually for, which decides how much work ffmpeg
+/// has to do.
+///
+/// This matters more than it looks. The old code re-encoded audio to AAC during
+/// *every* join, including the video join of a title that has separate audio
+/// renditions — where the remux then drops that audio stream entirely
+/// (`-map 0:v:0`). On a two-hour film that is minutes of CPU spent producing a
+/// stream that is thrown away.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum JoinMode {
+    /// The video carries the only audio there is: keep and normalise it.
+    VideoWithAudio,
+    /// Separate audio renditions will replace this file's audio, so don't
+    /// bother producing any.
+    VideoOnly,
+    /// An audio rendition. The remux copies it, so copy it here too.
+    AudioOnly,
+}
+
+impl JoinMode {
+    fn codec_args(self) -> &'static [&'static str] {
+        match self {
+            JoinMode::VideoWithAudio => &[
+                "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", "-af",
+                "aresample=async=1000",
+            ],
+            JoinMode::VideoOnly => &["-c:v", "copy", "-an"],
+            // HLS audio renditions are already AAC, so this is a remux, not a
+            // transcode. `retry_codec_args` covers the rare stream that is not.
+            JoinMode::AudioOnly => &["-vn", "-c:a", "copy"],
+        }
+    }
+
+    /// A second attempt for a stream that could not simply be copied.
+    fn retry_codec_args(self) -> Option<&'static [&'static str]> {
+        match self {
+            JoinMode::AudioOnly => Some(&["-vn", "-c:a", "aac", "-b:a", "192k"]),
+            _ => None,
+        }
+    }
+}
+
+/// Concatenate `segments` (in order) into `output`.
+///
+/// Byte-level concatenation is deliberate: MPEG-TS is a continuous stream
+/// format, so feeding the raw bytes through lets ffmpeg's TS demuxer recover
+/// PCR/PTS continuity itself, which the concat demuxer does not do as well.
+pub async fn join_segments(
+    segments: &[PathBuf],
+    output: &Path,
+    mode: JoinMode,
+    cancel: &CancellationToken,
+) -> Result<()> {
+    let started = std::time::Instant::now();
+    let outcome = join_once(segments, output, mode.codec_args(), cancel).await;
+
+    let outcome = match (&outcome, mode.retry_codec_args()) {
+        (Err(EngineError::Ffmpeg { .. }), Some(fallback)) => {
+            tracing::warn!("join {mode:?}: copia diretta rifiutata, riprovo ricodificando");
+            join_once(segments, output, fallback, cancel).await
+        }
+        _ => outcome,
+    };
+
+    if outcome.is_ok() {
+        tracing::info!(
+            "join {mode:?} completato in {:.1}s ({} segmenti)",
+            started.elapsed().as_secs_f64(),
+            segments.len()
+        );
+    }
+    outcome
+}
+
+async fn join_once(
+    segments: &[PathBuf],
+    output: &Path,
+    codec_args: &[&str],
+    cancel: &CancellationToken,
+) -> Result<()> {
+    if let Some(parent) = output.parent() {
+        tokio::fs::create_dir_all(parent).await.at(parent)?;
+    }
+    let output_str = output.to_string_lossy().into_owned();
+
+    let mut args: Vec<&str> = vec![
+        "-hide_banner",
+        "-loglevel",
+        "error",
+        // Piped input cannot be re-read, so ffmpeg needs enough of a window to
+        // identify the streams before it commits. `analyzeduration` is in
+        // microseconds: 10M is ten seconds of stream, which is plenty for a TS
+        // and far cheaper than the 100s the first cut of this asked for.
+        "-probesize",
+        "20M",
+        "-analyzeduration",
+        "10M",
+        "-fflags",
+        "+genpts",
+        "-avoid_negative_ts",
+        "make_zero",
+        "-i",
+        "pipe:0",
+    ];
+    args.extend_from_slice(codec_args);
+    if is_mp4(output) {
+        args.extend_from_slice(&["-movflags", "+faststart"]);
+    }
+    args.extend_from_slice(&["-y", &output_str]);
+
+    let mut child = spawn(&args, "join")?;
+
+    let stdin = child.stdin.take().ok_or_else(|| EngineError::Ffmpeg {
+        stage: "join".into(),
+        code: "pipe".into(),
+        stderr: "stdin non disponibile".into(),
+    })?;
+    let mut stderr = child.stderr.take().ok_or_else(|| EngineError::Ffmpeg {
+        stage: "join".into(),
+        code: "pipe".into(),
+        stderr: "stderr non disponibile".into(),
+    })?;
+
+    // stderr must be drained while writing, or a chatty ffmpeg fills its pipe
+    // buffer and both processes block forever.
+    let stderr_task = tokio::spawn(async move {
+        let mut buf = Vec::new();
+        let _ = stderr.read_to_end(&mut buf).await;
+        buf
+    });
+
+    // `stdin` is *moved* in here on purpose. ffmpeg only sees EOF when the write
+    // end of the pipe is closed, and for `ChildStdin` that happens on drop —
+    // `shutdown()` alone leaves the descriptor open and both processes wait for
+    // each other forever. Owning it here means every exit from this block,
+    // including a cancellation that drops the future, closes the pipe.
+    let feed = async move {
+        let mut stdin = stdin;
+        let mut copy_buf = vec![0u8; 1 << 20];
+        for path in segments {
+            let mut file = tokio::fs::File::open(path).await.at(path)?;
+            loop {
+                let read = file.read(&mut copy_buf).await.at(path)?;
+                if read == 0 {
+                    break;
+                }
+                // A broken pipe here means ffmpeg exited early; its stderr
+                // explains why, so stop feeding and let the exit status talk.
+                if stdin.write_all(&copy_buf[..read]).await.is_err() {
+                    return Ok(false);
+                }
+            }
+        }
+        let _ = stdin.flush().await;
+        drop(stdin);
+        Ok::<bool, EngineError>(true)
+    };
+
+    let fed = tokio::select! {
+        biased;
+        _ = cancel.cancelled() => {
+            let _ = child.kill().await;
+            let _ = stderr_task.await;
+            return Err(EngineError::Cancelled);
+        }
+        result = feed => result,
+    };
+    // `stdin` is dropped by now either way, closing the pipe so ffmpeg can
+    // finish; propagate a genuine read error only after that.
+    let fed = fed?;
+
+    let status = tokio::select! {
+        biased;
+        _ = cancel.cancelled() => {
+            let _ = child.kill().await;
+            let _ = stderr_task.await;
+            return Err(EngineError::Cancelled);
+        }
+        status = child.wait() => status.map_err(|e| EngineError::Ffmpeg {
+            stage: "join".into(),
+            code: "wait".into(),
+            stderr: e.to_string(),
+        })?,
+    };
+
+    let stderr_bytes = stderr_task.await.unwrap_or_default();
+
+    if !status.success() {
+        return Err(EngineError::Ffmpeg {
+            stage: "join".into(),
+            code: status
+                .code()
+                .map(|c| c.to_string())
+                .unwrap_or_else(|| "segnale".into()),
+            stderr: tail(&stderr_bytes),
+        });
+    }
+    if !fed {
+        return Err(EngineError::Ffmpeg {
+            stage: "join".into(),
+            code: "EPIPE".into(),
+            stderr: format!(
+                "ffmpeg ha chiuso l'input prima della fine dei segmenti: {}",
+                tail(&stderr_bytes)
+            ),
+        });
+    }
+    Ok(())
+}
+
+/// Build the argument list for the final remux.
+///
+/// Split out from the process handling so the mapping — the part that has
+/// actually been wrong before — is testable without running ffmpeg. The
+/// per-stream `-map`/`-metadata`/`-disposition` options are *output* options
+/// and must appear after every `-i` but before the output filename; putting
+/// them anywhere else makes ffmpeg ignore them silently, which is how subtitle
+/// language tags went missing for a while.
+fn remux_args(
+    video: &Path,
+    audio: &[AudioTrack],
+    subtitles: &[SubtitleTrack],
+    output: &Path,
+) -> Vec<String> {
+    let mut args: Vec<String> = vec![
+        "-hide_banner".into(),
+        "-loglevel".into(),
+        "error".into(),
+        "-y".into(),
+        "-i".into(),
+        video.to_string_lossy().into_owned(),
+    ];
+    for track in audio {
+        args.push("-i".into());
+        args.push(track.path.to_string_lossy().into_owned());
+    }
+    for track in subtitles {
+        args.push("-i".into());
+        args.push(track.path.to_string_lossy().into_owned());
+    }
+
+    args.push("-map".into());
+    args.push("0:v:0".into());
+    if audio.is_empty() {
+        // Keep whatever audio the video already carries.
+        args.push("-map".into());
+        args.push("0:a?".into());
+    } else {
+        for i in 0..audio.len() {
+            args.push("-map".into());
+            args.push(format!("{}:a:0", i + 1));
+        }
+    }
+    for i in 0..subtitles.len() {
+        args.push("-map".into());
+        args.push(format!("{}:0", audio.len() + 1 + i));
+    }
+
+    // Matroska carries WebVTT natively. MP4 has no WebVTT track type, so there
+    // the subtitles become 3GPP timed text — the only conversion anywhere: the
+    // picture and the sound are always copied.
+    let subtitle_codec = if is_mp4(output) { "mov_text" } else { "copy" };
+    args.extend(
+        ["-c:v", "copy", "-c:a", "copy", "-c:s", subtitle_codec]
+            .iter()
+            .map(|s| s.to_string()),
+    );
+
+    for (i, track) in audio.iter().enumerate() {
+        let (code, _) = lang::normalize(&track.language);
+        args.push(format!("-metadata:s:a:{i}"));
+        args.push(format!("language={code}"));
+    }
+    for (i, track) in subtitles.iter().enumerate() {
+        let (code, forced) = lang::normalize(&track.language);
+        let mut name = lang::display_name(code);
+        if forced {
+            name.push_str(" (Forced)");
+        }
+        args.push(format!("-metadata:s:s:{i}"));
+        args.push(format!("language={code}"));
+        args.push(format!("-metadata:s:s:{i}"));
+        args.push(format!("title={name}"));
+        args.push(format!("-disposition:s:{i}"));
+        args.push(if forced { "forced".into() } else { "0".into() });
+    }
+
+    if is_mp4(output) {
+        args.push("-movflags".into());
+        args.push("+faststart".into());
+    }
+
+    args.push(output.to_string_lossy().into_owned());
+    args
+}
+
+/// Remux external audio/subtitle tracks into `video`, keeping its container.
+///
+/// The result replaces `video` only once ffmpeg has finished; until then the
+/// work happens in `staging_path(video)`. Nothing to add means nothing to do.
+pub async fn remux(
+    video: &Path,
+    audio: &[AudioTrack],
+    subtitles: &[SubtitleTrack],
+    cancel: &CancellationToken,
+) -> Result<()> {
+    if audio.is_empty() && subtitles.is_empty() {
+        return Ok(());
+    }
+
+    let output = staging_path(video);
+    let args = remux_args(video, audio, subtitles, &output);
+    let borrowed: Vec<&str> = args.iter().map(|s| s.as_str()).collect();
+
+    tracing::info!(
+        "remux: video + {} tracce audio + {} sottotitoli",
+        audio.len(),
+        subtitles.len()
+    );
+
+    let mut child = spawn(&borrowed, "remux")?;
+    let mut stderr = child.stderr.take().ok_or_else(|| EngineError::Ffmpeg {
+        stage: "remux".into(),
+        code: "pipe".into(),
+        stderr: "stderr non disponibile".into(),
+    })?;
+    drop(child.stdin.take());
+
+    let stderr_task = tokio::spawn(async move {
+        let mut buf = Vec::new();
+        let _ = stderr.read_to_end(&mut buf).await;
+        buf
+    });
+
+    let status = tokio::select! {
+        biased;
+        _ = cancel.cancelled() => {
+            let _ = child.kill().await;
+            let _ = stderr_task.await;
+            let _ = tokio::fs::remove_file(&output).await;
+            return Err(EngineError::Cancelled);
+        }
+        status = child.wait() => status.map_err(|e| EngineError::Ffmpeg {
+            stage: "remux".into(),
+            code: "wait".into(),
+            stderr: e.to_string(),
+        })?,
+    };
+
+    let stderr_bytes = stderr_task.await.unwrap_or_default();
+    if !status.success() {
+        let _ = tokio::fs::remove_file(&output).await;
+        return Err(EngineError::Ffmpeg {
+            stage: "remux".into(),
+            code: status
+                .code()
+                .map(|c| c.to_string())
+                .unwrap_or_else(|| "segnale".into()),
+            stderr: tail(&stderr_bytes),
+        });
+    }
+
+    tokio::fs::rename(&output, video).await.at(video)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn args_of(audio: &[AudioTrack], subs: &[SubtitleTrack]) -> Vec<String> {
+        remux_args(
+            Path::new("/lib/Film.mkv"),
+            audio,
+            subs,
+            Path::new("/lib/.Film.mkv"),
+        )
+    }
+
+    fn mp4_args_of(audio: &[AudioTrack], subs: &[SubtitleTrack]) -> Vec<String> {
+        remux_args(
+            Path::new("/lib/Film.mp4"),
+            audio,
+            subs,
+            Path::new("/lib/.Film.mp4"),
+        )
+    }
+
+    fn option_value<'a>(args: &'a [String], flag: &str) -> Option<&'a str> {
+        args.windows(2)
+            .find(|w| w[0] == flag)
+            .map(|w| w[1].as_str())
+    }
+
+    fn audio(language: &str) -> AudioTrack {
+        AudioTrack {
+            path: PathBuf::from(format!("/tmp/{language}.mp4")),
+            language: language.to_string(),
+        }
+    }
+
+    fn subtitle(language: &str) -> SubtitleTrack {
+        SubtitleTrack {
+            path: PathBuf::from(format!("/tmp/{language}.vtt")),
+            language: language.to_string(),
+        }
+    }
+
+    /// Every per-stream option must sit after the last `-i` and before the
+    /// output path, or ffmpeg drops it without complaining.
+    #[test]
+    fn per_stream_options_land_between_the_inputs_and_the_output() {
+        let args = args_of(&[audio("ita")], &[subtitle("eng")]);
+        let last_input = args
+            .iter()
+            .rposition(|a| a == "-i")
+            .expect("there is an input");
+        let first_metadata = args
+            .iter()
+            .position(|a| a.starts_with("-metadata:s:"))
+            .expect("there is metadata");
+        assert!(first_metadata > last_input);
+        assert_eq!(args.last().map(String::as_str), Some("/lib/.Film.mkv"));
+    }
+
+    /// Matroska takes WebVTT as-is and has no `movflags`; MP4 needs both the
+    /// timed-text conversion and the faststart flag.
+    #[test]
+    fn the_container_decides_the_subtitle_codec_and_the_muxer_flags() {
+        let mkv = args_of(&[], &[subtitle("ita")]);
+        assert_eq!(option_value(&mkv, "-c:s"), Some("copy"));
+        assert!(!mkv.contains(&"-movflags".to_string()), "{mkv:?}");
+
+        let mp4 = mp4_args_of(&[], &[subtitle("ita")]);
+        assert_eq!(option_value(&mp4, "-c:s"), Some("mov_text"));
+        assert_eq!(option_value(&mp4, "-movflags"), Some("+faststart"));
+        assert_eq!(mp4.last().map(String::as_str), Some("/lib/.Film.mp4"));
+    }
+
+    #[test]
+    fn staging_keeps_the_folder_and_the_extension_but_hides_the_file() {
+        assert_eq!(
+            staging_path(Path::new("/lib/Film (2020)/Film (2020).mkv")),
+            PathBuf::from("/lib/Film (2020)/.Film (2020).mkv")
+        );
+    }
+
+    #[test]
+    fn stream_indices_account_for_every_preceding_input() {
+        let args = args_of(&[audio("ita"), audio("eng")], &[subtitle("ita")]);
+        let maps: Vec<&String> = args
+            .iter()
+            .enumerate()
+            .filter(|(i, _)| i > &0 && args[i - 1] == "-map")
+            .map(|(_, a)| a)
+            .collect();
+        // video, two audio inputs (1,2), then the subtitle input (3)
+        assert_eq!(maps, vec!["0:v:0", "1:a:0", "2:a:0", "3:0"]);
+    }
+
+    #[test]
+    fn without_external_audio_the_original_track_is_kept() {
+        let args = args_of(&[], &[subtitle("ita")]);
+        assert!(args.windows(2).any(|w| w[0] == "-map" && w[1] == "0:a?"));
+        // The single subtitle is then input 1, not input 0.
+        assert!(args.windows(2).any(|w| w[0] == "-map" && w[1] == "1:0"));
+    }
+
+    /// `forced-ita` must become a real language plus a disposition, never a
+    /// literal language code that players render as "Undefined".
+    #[test]
+    fn forced_subtitles_get_a_code_a_title_and_a_disposition() {
+        let args = args_of(&[], &[subtitle("forced-ita")]);
+        assert!(args.contains(&"language=ita".to_string()));
+        assert!(args.contains(&"title=Italian (Forced)".to_string()));
+        let disposition = args
+            .iter()
+            .position(|a| a == "-disposition:s:0")
+            .expect("disposition present");
+        assert_eq!(args[disposition + 1], "forced");
+    }
+
+    #[test]
+    fn ordinary_subtitles_get_a_cleared_disposition() {
+        let args = args_of(&[], &[subtitle("eng")]);
+        let disposition = args
+            .iter()
+            .position(|a| a == "-disposition:s:0")
+            .expect("disposition present");
+        assert_eq!(args[disposition + 1], "0");
+    }
+
+    /// The waste this mode exists to remove: when separate audio renditions
+    /// will replace it, the video join must not spend minutes encoding an AAC
+    /// stream that the remux then drops with `-map 0:v:0`.
+    #[test]
+    fn a_video_join_that_will_be_re_audioed_encodes_no_audio() {
+        let args = JoinMode::VideoOnly.codec_args();
+        assert!(args.contains(&"-an"), "{args:?}");
+        assert!(!args.contains(&"aac"), "no transcode should be requested");
+    }
+
+    #[test]
+    fn a_video_join_that_keeps_its_own_audio_still_normalises_it() {
+        let args = JoinMode::VideoWithAudio.codec_args();
+        assert!(args.contains(&"aac"));
+        assert!(args.contains(&"aresample=async=1000"));
+        assert!(!args.contains(&"-an"));
+    }
+
+    /// The remux copies audio renditions, so joining them should copy too —
+    /// with a re-encode held in reserve for a stream mp4 will not take.
+    #[test]
+    fn an_audio_join_copies_first_and_can_fall_back() {
+        let args = JoinMode::AudioOnly.codec_args();
+        assert_eq!(args, &["-vn", "-c:a", "copy"]);
+
+        let fallback = JoinMode::AudioOnly
+            .retry_codec_args()
+            .expect("a copy that fails must have somewhere to go");
+        assert!(fallback.contains(&"aac"));
+
+        // A video join has no fallback: re-running it would cost as much as the
+        // original attempt and fail the same way.
+        assert!(JoinMode::VideoOnly.retry_codec_args().is_none());
+        assert!(JoinMode::VideoWithAudio.retry_codec_args().is_none());
+    }
+
+    #[test]
+    fn stderr_tail_is_bounded_and_utf8_safe() {
+        let noisy = "à".repeat(4000);
+        let out = tail(noisy.as_bytes());
+        assert!(out.len() <= STDERR_KEEP + 8);
+        assert!(out.starts_with("..."));
+    }
+}
diff --git a/engine/src/http.rs b/engine/src/http.rs
new file mode 100644
index 0000000..539b707
--- /dev/null
+++ b/engine/src/http.rs
@@ -0,0 +1,370 @@
+//! The retrying HTTP client.
+//!
+//! Two of the three bugs found in production lived here, in the Python version:
+//!
+//! * `get_info()` fetched the rendition playlist exactly once, so one transient
+//!   CDN 500 killed the whole download.
+//! * `get_req_ts()` looked like it retried three times, but only 429 actually
+//!   looped — every other status returned on the first attempt. A burst of
+//!   503s silently dropped 2929 segments from one real download while the
+//!   progress bar still read 100%.
+//!
+//! Both were the same mistake: deciding *per status code* whether to retry, in
+//! code duplicated at each call site. Here the retry policy is written once,
+//! and the classification is exhaustive — a status is transient, permanent, or
+//! success, with no fourth path that quietly gives up.
+
+use std::time::Duration;
+
+use reqwest::StatusCode;
+use tokio_util::sync::CancellationToken;
+
+use crate::error::{EngineError, Result};
+
+/// Attempts per request, including the first.
+const MAX_ATTEMPTS: u32 = 5;
+const BASE_BACKOFF_MS: u64 = 500;
+const MAX_BACKOFF: Duration = Duration::from_secs(20);
+
+/// How long a single body read may produce nothing before the attempt is
+/// abandoned. This is the fix for the stall the panel could only paper over
+/// with a 90-second job-level heuristic: a CDN throttled to a trickle keeps
+/// delivering *a* byte often enough that a whole-request timeout never fires,
+/// so the timeout has to sit on the gap between chunks instead.
+const CHUNK_TIMEOUT: Duration = Duration::from_secs(20);
+
+/// Upper bound on one segment fetch regardless of how steadily it dribbles in.
+const SEGMENT_DEADLINE: Duration = Duration::from_secs(180);
+
+const TEXT_DEADLINE: Duration = Duration::from_secs(30);
+
+#[derive(Clone)]
+pub struct HttpClient {
+    inner: reqwest::Client,
+    user_agent: String,
+    referer: Option<String>,
+    cancel: CancellationToken,
+}
+
+/// What to do about a response, decided in exactly one place.
+enum Disposition {
+    Success,
+    Retry,
+    /// vixcloud.co quirk: some episode playlists 403 until `?b=1` is appended.
+    RetryWithB1,
+    Fatal,
+}
+
+fn classify(status: StatusCode, b1_available: bool) -> Disposition {
+    if status.is_success() {
+        return Disposition::Success;
+    }
+    match status {
+        StatusCode::FORBIDDEN if b1_available => Disposition::RetryWithB1,
+        // 403 without the b=1 card left to play is still worth retrying: the
+        // CDN hands them out under load, not only for genuinely denied URLs.
+        StatusCode::FORBIDDEN
+        | StatusCode::REQUEST_TIMEOUT
+        | StatusCode::TOO_MANY_REQUESTS
+        | StatusCode::INTERNAL_SERVER_ERROR
+        | StatusCode::BAD_GATEWAY
+        | StatusCode::SERVICE_UNAVAILABLE
+        | StatusCode::GATEWAY_TIMEOUT => Disposition::Retry,
+        s if s.is_server_error() => Disposition::Retry,
+        _ => Disposition::Fatal,
+    }
+}
+
+/// Append the vixcloud `b=1` escape hatch, respecting an existing query string.
+pub fn with_b1(url: &str) -> String {
+    if url.contains("b=1") {
+        url.to_string()
+    } else if url.contains('?') {
+        format!("{url}&b=1")
+    } else {
+        format!("{url}?b=1")
+    }
+}
+
+/// Exponential backoff with full jitter. Without the jitter, 16 segment workers
+/// that hit the same 503 retry in lockstep and reproduce the burst that caused
+/// it.
+fn backoff(attempt: u32, retry_after: Option<Duration>) -> Duration {
+    if let Some(d) = retry_after {
+        return d.min(MAX_BACKOFF);
+    }
+    let ceiling = BASE_BACKOFF_MS.saturating_mul(1u64 << attempt.min(6));
+    let jittered = if ceiling == 0 {
+        0
+    } else {
+        rand::random::<u64>() % ceiling
+    };
+    Duration::from_millis(BASE_BACKOFF_MS / 2 + jittered).min(MAX_BACKOFF)
+}
+
+fn retry_after_of(resp: &reqwest::Response) -> Option<Duration> {
+    resp.headers()
+        .get(reqwest::header::RETRY_AFTER)?
+        .to_str()
+        .ok()?
+        .trim()
+        .parse::<u64>()
+        .ok()
+        .map(Duration::from_secs)
+}
+
+impl HttpClient {
+    pub fn new(
+        user_agent: String,
+        referer: Option<String>,
+        cancel: CancellationToken,
+    ) -> Result<Self> {
+        let inner = reqwest::Client::builder()
+            // Connections are pooled and reused across all segment workers;
+            // opening a fresh TLS session per segment was a measurable share of
+            // the old downloader's wall time.
+            .pool_max_idle_per_host(32)
+            .connect_timeout(Duration::from_secs(15))
+            .build()
+            .map_err(|source| EngineError::Http {
+                context: "creazione client HTTP".into(),
+                source,
+            })?;
+        Ok(Self {
+            inner,
+            user_agent,
+            referer,
+            cancel,
+        })
+    }
+
+    fn request(&self, url: &str) -> reqwest::RequestBuilder {
+        let mut req = self
+            .inner
+            .get(url)
+            .header(reqwest::header::USER_AGENT, &self.user_agent);
+        if let Some(referer) = &self.referer {
+            req = req.header(reqwest::header::REFERER, referer);
+        }
+        req
+    }
+
+    /// Fetch a playlist (or any small text resource) with the full retry policy.
+    pub async fn fetch_text(&self, url: &str, context: &str) -> Result<String> {
+        let bytes = self.fetch(url, context, TEXT_DEADLINE, true).await?;
+        Ok(String::from_utf8_lossy(&bytes).into_owned())
+    }
+
+    /// Fetch one media segment. `b=1` is not attempted here: segment URLs come
+    /// from a playlist that was already resolved with whatever query string
+    /// works, and rewriting them would break signed URLs.
+    pub async fn fetch_segment(&self, url: &str, context: &str) -> Result<Vec<u8>> {
+        self.fetch(url, context, SEGMENT_DEADLINE, false).await
+    }
+
+    async fn fetch(
+        &self,
+        url: &str,
+        context: &str,
+        deadline: Duration,
+        allow_b1: bool,
+    ) -> Result<Vec<u8>> {
+        let mut current = url.to_string();
+        let mut b1_available = allow_b1 && !url.contains("b=1");
+        let mut last_status = StatusCode::OK;
+
+        for attempt in 0..MAX_ATTEMPTS {
+            if self.cancel.is_cancelled() {
+                return Err(EngineError::Cancelled);
+            }
+
+            let send = self.request(&current).send();
+            let resp = tokio::select! {
+                biased;
+                _ = self.cancel.cancelled() => return Err(EngineError::Cancelled),
+                r = send => r,
+            };
+
+            let mut resp = match resp {
+                Ok(r) => r,
+                Err(source) => {
+                    // Connection reset, DNS hiccup, TLS error: all transient
+                    // until proven otherwise by running out of attempts.
+                    if attempt + 1 == MAX_ATTEMPTS {
+                        return Err(EngineError::Http {
+                            context: context.to_string(),
+                            source,
+                        });
+                    }
+                    tracing::warn!(
+                        "{context}: errore di rete (tentativo {}/{MAX_ATTEMPTS}): {source}",
+                        attempt + 1
+                    );
+                    self.sleep(backoff(attempt, None)).await?;
+                    continue;
+                }
+            };
+
+            last_status = resp.status();
+            match classify(last_status, b1_available) {
+                Disposition::Success => {
+                    return self.read_body(&mut resp, context, deadline).await;
+                }
+                Disposition::RetryWithB1 => {
+                    tracing::warn!("{context}: HTTP 403, riprovo con ?b=1");
+                    current = with_b1(&current);
+                    b1_available = false;
+                    self.sleep(backoff(attempt, None)).await?;
+                }
+                Disposition::Retry => {
+                    if attempt + 1 == MAX_ATTEMPTS {
+                        break;
+                    }
+                    let wait = backoff(attempt, retry_after_of(&resp));
+                    tracing::warn!(
+                        "{context}: HTTP {} (tentativo {}/{MAX_ATTEMPTS}), riprovo fra {:?}",
+                        last_status.as_u16(),
+                        attempt + 1,
+                        wait
+                    );
+                    self.sleep(wait).await?;
+                }
+                Disposition::Fatal => {
+                    return Err(EngineError::HttpStatus {
+                        context: context.to_string(),
+                        status: last_status.as_u16(),
+                        attempts: attempt + 1,
+                    });
+                }
+            }
+        }
+
+        Err(EngineError::HttpStatus {
+            context: context.to_string(),
+            status: last_status.as_u16(),
+            attempts: MAX_ATTEMPTS,
+        })
+    }
+
+    /// Read a body chunk by chunk, giving up on the gap between chunks rather
+    /// than on total elapsed time — see `CHUNK_TIMEOUT`.
+    async fn read_body(
+        &self,
+        resp: &mut reqwest::Response,
+        context: &str,
+        deadline: Duration,
+    ) -> Result<Vec<u8>> {
+        let started = tokio::time::Instant::now();
+        let mut buf: Vec<u8> = match resp.content_length() {
+            Some(n) if n <= 64 * 1024 * 1024 => Vec::with_capacity(n as usize),
+            _ => Vec::new(),
+        };
+
+        loop {
+            let next = resp.chunk();
+            let chunk = tokio::select! {
+                biased;
+                _ = self.cancel.cancelled() => return Err(EngineError::Cancelled),
+                r = tokio::time::timeout(CHUNK_TIMEOUT, next) => r,
+            };
+
+            match chunk {
+                Err(_elapsed) => {
+                    return Err(EngineError::Stalled {
+                        context: context.to_string(),
+                        secs: CHUNK_TIMEOUT.as_secs(),
+                    });
+                }
+                Ok(Err(source)) => {
+                    return Err(EngineError::Http {
+                        context: context.to_string(),
+                        source,
+                    });
+                }
+                Ok(Ok(None)) => return Ok(buf),
+                Ok(Ok(Some(bytes))) => {
+                    buf.extend_from_slice(&bytes);
+                    if started.elapsed() > deadline {
+                        return Err(EngineError::Stalled {
+                            context: context.to_string(),
+                            secs: deadline.as_secs(),
+                        });
+                    }
+                }
+            }
+        }
+    }
+
+    /// A sleep that a cancellation cuts short. Every wait in the engine goes
+    /// through here, so SIGTERM never has to outwait a backoff.
+    async fn sleep(&self, d: Duration) -> Result<()> {
+        tokio::select! {
+            biased;
+            _ = self.cancel.cancelled() => Err(EngineError::Cancelled),
+            _ = tokio::time::sleep(d) => Ok(()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn b1_respects_existing_query() {
+        assert_eq!(with_b1("https://x/y"), "https://x/y?b=1");
+        assert_eq!(with_b1("https://x/y?t=1"), "https://x/y?t=1&b=1");
+    }
+
+    #[test]
+    fn b1_is_not_applied_twice() {
+        assert_eq!(with_b1("https://x/y?b=1"), "https://x/y?b=1");
+    }
+
+    /// The regression that dropped 2929 segments: every transient server status
+    /// must retry, not just 429.
+    #[test]
+    fn transient_statuses_all_retry() {
+        for code in [408u16, 429, 500, 502, 503, 504, 507] {
+            let status = StatusCode::from_u16(code).expect("valid status");
+            assert!(
+                matches!(classify(status, false), Disposition::Retry),
+                "HTTP {code} should be retried"
+            );
+        }
+    }
+
+    #[test]
+    fn client_errors_are_fatal() {
+        for code in [400u16, 401, 404, 410] {
+            let status = StatusCode::from_u16(code).expect("valid status");
+            assert!(matches!(classify(status, false), Disposition::Fatal));
+        }
+    }
+
+    #[test]
+    fn forbidden_prefers_b1_then_falls_back_to_plain_retry() {
+        assert!(matches!(
+            classify(StatusCode::FORBIDDEN, true),
+            Disposition::RetryWithB1
+        ));
+        assert!(matches!(
+            classify(StatusCode::FORBIDDEN, false),
+            Disposition::Retry
+        ));
+    }
+
+    #[test]
+    fn backoff_is_bounded_and_jittered() {
+        for attempt in 0..10 {
+            let d = backoff(attempt, None);
+            assert!(d <= MAX_BACKOFF, "attempt {attempt} exceeded the ceiling");
+        }
+        assert_eq!(
+            backoff(0, Some(Duration::from_secs(3))),
+            Duration::from_secs(3)
+        );
+        // A hostile Retry-After must not park a worker for an hour.
+        assert_eq!(backoff(0, Some(Duration::from_secs(9999))), MAX_BACKOFF);
+    }
+}
