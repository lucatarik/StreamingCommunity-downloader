__pycache__
*.pyc
*.pyo
.venv
venv
videos/
tmp/
.git
.gitignore
.pytest_cache/

docker-compose.yml

# README screenshots and the design doc: repo-only, never needed at runtime.
# Keeping them out also stops the design doc from being served and drops ~5 MB
# from the image. The favicon lives in app/static/, not here.
docs/
design/

# Tests and their dependencies do not belong in the runtime image.
tests/
requirements-dev.txt

# Rust build artefacts: the engine is compiled in its own build stage, so a
# local target/ directory (gigabytes, and built for the host, not the image)
# must never be copied in.
engine/target/

# Runtime state must never be baked into the image. panel.db in particular
# holds the Jellyfin service API key, and `COPY . .` would ship a developer's
# copy of it to anyone who pulls the image.
panel.db
data.json
schedule.json
